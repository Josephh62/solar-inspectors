generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Job {
  id             String    @id @default(cuid())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  address        String?
  clientName     String?
  inspectorName  String?
  inspectionDate DateTime?
  notes          String?
  status         JobStatus @default(DRAFT)
  errorMessage   String?
  photos         Photo[]
  analysis       Analysis?
  report         Report?
}

enum JobStatus {
  DRAFT
  ANALYZING
  REVIEW
  GENERATING
  COMPLETE
  ERROR
}

model Photo {
  id            String         @id @default(cuid())
  createdAt     DateTime       @default(now())
  jobId         String
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  originalName  String
  originalPath  String         @default("")
  mimeType      String
  sizeBytes     Int
  imageData     String?
  processedPath String?
  category      PhotoCategory?
  aiDescription String?
  sortOrder     Int            @default(0)
}

enum PhotoCategory {
  PANELS
  INVERTER
  MOUNTING
  METER_DISPLAY
  AERIAL
  BLUEPRINT
  SITE_PLAN
  GENERAL
}

model Analysis {
  id            String   @id @default(cuid())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  jobId         String   @unique
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  rawExtraction Json
  reviewedData  Json
  panelCount    Int?
  issueCount    Int      @default(0)
}

model Report {
  id               String   @id @default(cuid())
  createdAt        DateTime @default(now())
  jobId            String   @unique
  job              Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  pdfPath          String   @default("")
  pdfSizeBytes     Int?
  templateSnapshot Json
}
